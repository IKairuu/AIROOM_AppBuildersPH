# Where the Next.js server reaches Ollama. Keep it on the laptop itself.
OLLAMA_HOST=http://127.0.0.1:11434

# Launch readiness checks. On unless set to "off".
NEXT_PUBLIC_LAUNCH_CHECKS=off

# Public demo mode for the hosted website (Vercel). Shows a "run it locally"
# banner, skips the launch checks and keeps data in a temp folder.
# Leave it unset on the laptop.
# NEXT_PUBLIC_DEMO_MODE=on
